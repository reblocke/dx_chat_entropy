# Python
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/

# Virtual envs
.venv/
venv/
ENV/

# uv
.uv/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Ruff
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/
notebooks/data/
notebooks/*.jsonl

# OS / editors
.DS_Store
.vscode/

# Local env files
.env
.env.*

# Config (keep the example, ignore local real config)
config/config.yaml

# Generated outputs (future runs)
/data/processed/*
!/data/processed/.gitkeep
!/data/processed/assessments/
!/data/processed/assessments/**
!/data/processed/nnt_lrs/
!/data/processed/nnt_lrs/**

/data/derived/*
!/data/derived/.gitkeep

/artifacts/*
!/artifacts/.gitkeep
# Feedback manifests, ledgers, attempts, responses, and workbooks are local model-run
# artifacts. Commit only deterministic synthetic fixtures under tests/fixtures/feedback/.
/artifacts/feedback_sheets/

/reports/*
!/reports/.gitkeep
!/reports/display_reasoning.html

# Notebook checkpoint and local scratch
*.nbconvert.ipynb

# Local tool state
/anaconda_projects/
/archive/local_state/

# Historical external/cache artifacts that should not be republished from the branch tip
/archive/legacy_external/

# Binary/private reference materials; document citations/links instead
docs/references/*.pdf
docs/references/*.doc
docs/references/*.docx
docs/references/*.ppt
docs/references/*.pptx

# Large or external model/data cache formats
*.db
*.hdf
*.pt
*.parquet
*.RData
*.rdata
